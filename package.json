{
  "name": "hunters-folio",
  "private": true,
  "version": "0.1.0",
  "description": "Hunter's Folio \u2014 a turn-based monster-hunting RPG with dice. Read the monster. Roll the dice. Break it apart.",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "tsx src/sim/cli.ts",
    "desktop": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win dir zip --x64",
    "steam:build": "node scripts/steam.mjs build",
    "steam:upload": "node scripts/steam.mjs upload"
  },
  "devDependencies": {
    "@fontsource/barlow": "5.3.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tsconfig/svelte": "5.0.8",
    "@types/node": "22.20.5",
    "electron": "44.9.0",
    "electron-builder": "26.17.0",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "4.1.12"
  },
  "build": {
    "appId": "com.huntersfolio.game",
    "productName": "Hunter's Folio",
    "copyright": "Copyright \u00a9 2026 Hunter's Folio",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/steamworks.js/dist/{linux64,osx}/**"
    ],
    "asarUnpack": [
      "node_modules/steamworks.js/**"
    ],
    "directories": {
      "output": "release"
    },
    "artifactName": "HuntersFolio-${version}-win-${arch}.${ext}",
    "win": {
      "target": [
        "dir",
        "zip"
      ]
    }
  },
  "dependencies": {
    "steamworks.js": "0.4.0"
  }
}
